{
  "name": "groupe-atc-squarespace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:fonts": "node scripts/download-fonts.mjs",
    "build:all": "npm run build:fonts && npm run build:icons && npm run build",
    "preview": "serve site -l 3000 --no-clipboard",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build:all && git add -A && git commit -m \"Build: $(date '+%Y-%m-%d %H:%M')\" && git push origin main"
  },
  "devDependencies": {
    "serve": "^14.2.0",
    "svgo": "^3.3.2"
  },
  "dependencies": {
    "@tabler/icons": "^3.50.0",
    "lucide": "^1.66.0"
  }
}
